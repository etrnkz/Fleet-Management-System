# Copy to .env on the server (same directory as ecosystem.config.cjs):
#   cp .env.production.example .env && nano .env
# Then: chmod +x scripts/migrate.sh && ./scripts/migrate.sh
#
# PM2 (ecosystem.config.cjs) loads this .env automatically for fleet-api.

NODE_ENV=production
PORT=3000

# --- PostgreSQL (must match the password you set for role DB_USERNAME) ---
# Option A — single URL (overrides DB_* below when set):
# DATABASE_URL=postgres://postgres:YOUR_STRONG_PASSWORD@127.0.0.1:5432/fleet_management

# Option B — discrete vars (used if DATABASE_URL is empty):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DB_NAME=fleet_management

# TLS to managed Postgres (RDS, etc.)
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# Empty database / no migration files yet: MUST use true once so tables are created, then set false:
# DB_SYNCHRONIZE=true
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Apply pending migrations when the API starts (optional; or use scripts/migrate.sh)
# DB_RUN_MIGRATIONS=true

# --- JWT (generate long random strings) ---
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM
JWT_REFRESH_EXPIRATION=7d

# --- Redis (Bull / queues) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Throttling ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- First production deploy (this repo ships no SQL migrations yet) ---
# Either:
#   A) One-time schema push: set DB_SYNCHRONIZE=true, start API once, stop, set false,
#      then on dev: npm run migration:generate -- src/migrations/InitialSchema  and commit.
#   B) Keep DB_SYNCHRONIZE=true only on private dev/stage (not recommended for public prod).
