# ─────────────────────────────────────────────────────────────────────────────
# Haramaya University Fleet Management System — Production Environment
#
# On the server:
#   cp .env.production.example .env
#   nano .env          ← fill in all CHANGE_ME values
#   chmod 600 .env
#   ./scripts/migrate.sh
#   pm2 start ecosystem.config.cjs
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=production
PORT=3000
API_PREFIX=api

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=fleet_management
DB_LOGGING=false
DB_SYNCHRONIZE=false
# DB_RUN_MIGRATIONS=true   # uncomment to auto-run migrations on startup

# Managed Postgres (RDS, Supabase, etc.) — enable TLS:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Normal session  : 7h access  / 7d refresh
# Remember Me     : 45d access / 45d refresh  (keepMeSignedIn=true in login)
#
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_MIN_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRATION=7h
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_64_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_EXPIRATION=7d

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_IF_SET

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=CHANGE_ME_your-email@gmail.com
EMAIL_PASSWORD=CHANGE_ME_gmail-app-password
EMAIL_FROM="Fleet Management <CHANGE_ME_your-email@gmail.com>"

# ── SMS (Brevo) ───────────────────────────────────────────────────────────────
BREVO_API_KEY=CHANGE_ME_brevo_api_key
SMS_SENDER_NAME=FleetMgmt

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── Frontend URL (for password reset email links) ─────────────────────────────
FRONTEND_URL=https://your-domain.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=warn
