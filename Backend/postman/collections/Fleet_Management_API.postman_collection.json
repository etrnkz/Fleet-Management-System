            "if(c===201) pm.environment.set('vehicle_id', pm.response.json().id);"
          ]}}]
        },
        {
          "name": "GET /vehicles/:id",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/vehicles/{{vehicle_id}}", "header": [{"key":"Authorization","value":"Bearer {{access_token}}"}] },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}]
        }
      ]
    },
