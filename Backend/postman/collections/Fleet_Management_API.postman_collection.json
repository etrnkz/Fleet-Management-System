{
  "info": {
    "name": "Fleet Management API",
    "_postman_id": "fleet-management-api",
    "description": "Complete API test suite — covers auth, full trip lifecycle (STANDARD, VIP, SERVICE), vehicles, drivers, maintenance, fuel, tracking, notifications, and audit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "{{base_url}}" }
  ],
  "item": [

    {
      "name": "0 — Health",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/health" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('DB connected', () => pm.expect(pm.response.json().database).to.eql('connected'));"
          ]}}]
        }
      ]
    },
    {
      "name": "1 — Auth",
      "item": [
        {
          "name": "Login — Admin",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/auth/login", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"email\":\"{{admin_email}}\",\"password\":\"{{admin_password}}\",\"appType\":\"system-admin\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json(); pm.environment.set('access_token', j.access_token); pm.environment.set('refresh_token', j.refresh_token);"
          ]}}]
        },
        {
          "name": "Login — President",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/auth/login", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"email\":\"{{president_email}}\",\"password\":\"{{user_password}}\",\"appType\":\"president\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.environment.set('president_token', pm.response.json().access_token);"
          ]}}]
        },
        {
          "name": "Login — Transport Office",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/auth/login", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"email\":\"{{transport_email}}\",\"password\":\"{{user_password}}\",\"appType\":\"transport-admin\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.environment.set('transport_token', pm.response.json().access_token);"
          ]}}]
        },
        {
          "name": "Login — Deployment Office",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/auth/login", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"email\":\"deployment@haramaya.edu.et\",\"password\":\"{{user_password}}\",\"appType\":\"deployment-office\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.environment.set('deployment_token', pm.response.json().access_token);"
          ]}}]
        },
        {
          "name": "Login — Driver",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/auth/login", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"email\":\"{{driver_email}}\",\"password\":\"{{user_password}}\",\"appType\":\"driver\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.environment.set('driver_token', pm.response.json().access_token);"
          ]}}]
        },
        {
          "name": "Login — Dean (CCI)",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/auth/login", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"email\":\"{{dean_email}}\",\"password\":\"{{user_password}}\",\"appType\":\"college-dean\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.environment.set('dean_token', pm.response.json().access_token);"
          ]}}]
        },
        {
          "name": "Login — Dept Head (CS)",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/auth/login", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"email\":\"{{dept_head_email}}\",\"password\":\"{{user_password}}\",\"appType\":\"department\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.environment.set('dept_head_token', pm.response.json().access_token);"
          ]}}]
        },
        {
          "name": "Login — Postman Employee",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/auth/login", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"email\":\"postman@haramaya.edu.et\",\"password\":\"Password@123\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.environment.set('employee_token', pm.response.json().access_token);",
            "pm.environment.set('employee_id', pm.response.json().user.id);"
          ]}}]
        },
        {
          "name": "POST /auth/refresh",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/auth/refresh", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"refresh_token\":\"{{refresh_token}}\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}]
        }
      ]
    },

    {
      "name": "2 — Users",
      "item": [
        {
          "name": "GET /users",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/users", "header": [{"key":"Authorization","value":"Bearer {{access_token}}"}] },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}]
        },
        {
          "name": "GET /users/me",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/users/me", "header": [{"key":"Authorization","value":"Bearer {{access_token}}"}] },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has email', () => pm.expect(pm.response.json()).to.have.property('email'));"
          ]}}]
        },
        {
          "name": "POST /users (create postman user)",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/users", "header": [{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"name\":\"Postman Tester\",\"email\":\"postman@haramaya.edu.et\",\"password\":\"Password@123\",\"role\":\"User\",\"phoneNumber\":\"+251912345678\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const s = pm.response.status; pm.test('201 or 409', () => pm.expect([201,409]).to.include(pm.response.code));",
            "if(pm.response.code===201){ pm.environment.set('postman_user_id', pm.response.json().id); }"
          ]}}]
        },
        {
          "name": "PATCH /users/me (update profile)",
          "request": { "method": "PATCH", "url": "{{base_url}}/api/v1/users/me", "header": [{"key":"Authorization","value":"Bearer {{employee_token}}"},{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"name\":\"Postman Tester Updated\",\"phoneNumber\":\"+251912345678\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}]
        }
      ]
    },
    {
      "name": "3 — Colleges & Departments",
      "item": [
        {
          "name": "GET /colleges",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/colleges", "header": [{"key":"Authorization","value":"Bearer {{access_token}}"}] },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json(); pm.test('Has colleges', () => pm.expect(j.length).to.be.above(0));",
            "if(j.length>0) pm.environment.set('college_id', j[0].id);"
          ]}}]
        },
        {
          "name": "GET /departments",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/departments", "header": [{"key":"Authorization","value":"Bearer {{access_token}}"}] },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json(); if(j.length>0) pm.environment.set('department_id', j[0].id);"
          ]}}]
        }
      ]
    },
