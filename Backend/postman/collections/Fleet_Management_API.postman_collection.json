        {
          "name": "POST /vehicles (create test vehicle)",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/vehicles", "header": [{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"plateNumber\":\"AA-TEST-001\",\"make\":\"Toyota\",\"model\":\"Land Cruiser\",\"year\":2022,\"capacity\":7,\"fuelType\":\"Diesel\",\"status\":\"Active\",\"currentMileage\":0,\"fuelCapacity\":80,\"fuelEfficiency\":8,\"color\":\"White\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
