{
	"info": {
		"_postman_id": "fleet-management-api",
		"name": "Fleet Management API",
		"description": "API tests for the Haramaya University Fleet Management System.\n\nPrerequisites:\n1. Run `npm run seed` to seed the database\n2. Set `admin_password` in the environment\n3. Run with: npx newman run postman/collections/Fleet_Management_API.postman_collection.json -e postman/environments/Fleet_Management_Environment.postman_environment.json",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "GET /health",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));", "pm.test(\"Status OK\", () => pm.expect(pm.response.json().status).to.eql(\"OK\"));"], "type": "text/javascript" } }],
					"request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/health" }
				},
				{
					"name": "GET / (root info)",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"], "type": "text/javascript" } }],
					"request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1" }
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "GET /auth/signup-metadata",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));", "pm.test(\"Has colleges and departments\", () => { const j = pm.response.json(); pm.expect(j).to.have.property(\"colleges\"); pm.expect(j).to.have.property(\"departments\"); });"], "type": "text/javascript" } }],
					"request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/auth/signup-metadata" }
				},
				{
					"name": "POST /auth/login (admin)",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Login succeeds\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));", "pm.test(\"Has access_token\", () => { const j = pm.response.json(); pm.expect(j).to.have.property(\"access_token\"); pm.environment.set(\"access_token\", j.access_token); pm.environment.set(\"refresh_token\", j.refresh_token || \"\"); pm.environment.set(\"user_id\", j.user.id); });"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" }, "url": "{{base_url}}/api/v1/auth/login" }
				},
				{
					"name": "POST /auth/login (invalid → 401)",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Invalid credentials returns 401\", () => pm.response.to.have.status(401));"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"wrong@example.com\",\n  \"password\": \"wrongpassword\"\n}" }, "url": "{{base_url}}/api/v1/auth/login" }
				},
				{
					"name": "POST /auth/refresh",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Refresh returns new tokens\", () => { pm.expect(pm.response.code).to.eql(200); const j = pm.response.json(); pm.expect(j).to.have.property(\"access_token\"); pm.environment.set(\"access_token\", j.access_token); });"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" }, "url": "{{base_url}}/api/v1/auth/refresh" }
				},
				{
					"name": "POST /auth/forgot-password",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Returns 200 or 201\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\"\n}" }, "url": "{{base_url}}/api/v1/auth/forgot-password" }
				},
				{
					"name": "POST /auth/reset-password (invalid token → 400)",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Invalid token returns 400 or 401\", () => pm.expect(pm.response.code).to.be.oneOf([400, 401]));"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"invalid-token-here\",\n  \"newPassword\": \"NewPassword@123\"\n}" }, "url": "{{base_url}}/api/v1/auth/reset-password" }
				},
				{
					"name": "POST /auth/logout",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Logout succeeds\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{base_url}}/api/v1/auth/logout" }
				}
			]
		},
		{
			"name": "Users",
			"item": [
				{
					"name": "GET /users/me",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));", "pm.test(\"Returns user profile\", () => { const j = pm.response.json(); pm.expect(j).to.have.property(\"email\"); pm.expect(j).to.have.property(\"role\"); });"], "type": "text/javascript" } }],
					"request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{base_url}}/api/v1/users/me" }
				},
				{
					"name": "PATCH /users/me (update profile)",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"], "type": "text/javascript" } }],
					"request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"System Administrator\",\n  \"phoneNumber\": \"+251911000000\"\n}" }, "url": "{{base_url}}/api/v1/users/me" }
				},
				{
					"name": "PATCH /users/me/password",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Status 200 or 400\", () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));"], "type": "text/javascript" } }],
					"request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{admin_password}}\",\n  \"newPassword\": \"NewPassword@123\"\n}" }, "url": "{{base_url}}/api/v1/users/me/password" }
				},
				{
					"name": "GET /users/me (no auth → 401)",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Requires auth\", () => pm.response.to.have.status(401));"], "type": "text/javascript" } }],
					"request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/users/me" }
				},
				{
					"name": "POST /users/bulk-invite (no auth → 401)",
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Requires auth\", () => pm.response.to.have.status(401));"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"emails\": [\"test@example.com\"] }" }, "url": "{{base_url}}/api/v1/users/bulk-invite" }
				}
			]
		},
