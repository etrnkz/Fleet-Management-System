			"item": [
				{
					"name": "GET /api/v1/health",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Body has status OK\", function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json).to.have.property(\"status\", \"OK\");",
									"});"
