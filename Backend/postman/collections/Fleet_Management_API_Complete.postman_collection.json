					"name": "POST /api/v1/users/bulk-invite",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Bulk invite status check\", function () {",
									"    // Should succeed with dean token or fail with employee token (403)",
									"    pm.expect(pm.response.code).to.be.oneOf([201, 403]);",
									"});",
									"if (pm.response.code === 201) {",
									"    pm.test(\"Bulk invite response structure\", function () {",
									"        const json = pm.response.json();",
									"        pm.expect(json).to.have.property(\"success\");",
									"        pm.expect(json).to.have.property(\"invited\");",
									"        pm.expect(json).to.have.property(\"failed\");",
									"        pm.expect(json).to.have.property(\"message\");",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
