			"name": "Authentication",
			"item": [
				{
					"name": "GET /api/v1/auth/signup-metadata",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Returns colleges and departments\", function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json).to.have.property(\"colleges\");",
									"    pm.expect(json).to.have.property(\"departments\");",
									"    pm.expect(json.colleges).to.be.an(\"array\");",
									"    pm.expect(json.departments).to.be.an(\"array\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/signup-metadata",
							"host": ["{{base_url}}"],
