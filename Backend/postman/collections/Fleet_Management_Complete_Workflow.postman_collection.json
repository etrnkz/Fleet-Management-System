		{
			"name": "2. Setup Test Data",
			"item": [
				{
					"name": "Create Test Vehicle",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const ts = Date.now();",
									"pm.environment.set('workflow_vehicle_plate', 'PM-' + String(ts).slice(-8));",
									"pm.environment.set('workflow_vehicle_code', 'VEH-PM-' + String(ts).slice(-6));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Vehicle created', function () {",
									"    pm.expect([200, 201]).to.include(pm.response.code);",
									"});",
									"const response = pm.response.json();",
									"pm.environment.set('test_vehicle_id', response.id);",
									"pm.environment.set('vehicle_plate_number', response.plateNumber);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{deployment_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"vehicleId\": \"{{workflow_vehicle_code}}\",\n  \"plateNumber\": \"{{workflow_vehicle_plate}}\",\n  \"vehicleType\": \"Bus\",\n  \"make\": \"Toyota\",\n  \"model\": \"Coaster\",\n  \"year\": 2023,\n  \"fuelType\": \"Diesel\",\n  \"status\": \"Active\",\n  \"capacity\": 30,\n  \"fuelCapacity\": 80,\n  \"currentMileage\": 15000\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/vehicles",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"vehicles"
							]
						},
						"description": "Unique plate each run. Requires deployment@test.com login."
					}
				},
				{
					"name": "Ensure Driver Profile (driver@test.com)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.environment.set('workflow_driver_license', 'DL-PM-' + Date.now());"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Driver profile created or already exists', function () {",
									"    pm.expect([201, 409]).to.include(pm.response.code);",
									"});",
									"if (pm.response.code === 201) {",
									"    pm.environment.set('test_driver_id', pm.response.json().id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{deployment_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": \"{{driver_user_id}}\",\n  \"licenseNumber\": \"{{workflow_driver_license}}\",\n  \"licenseExpiry\": \"2030-12-31\",\n  \"experienceYears\": 5\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/drivers",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"drivers"
							]
						},
						"description": "409 if profile already exists (re-runs). User driver@test.com must exist (Backend/seed_all.py)."
					}
				},
				{
					"name": "Resolve Driver Id for Allocation",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Driver resolved for allocation', function () {",
									"    pm.response.to.have.status(200);",
									"    const drivers = pm.response.json();",
									"    const uid = pm.environment.get('driver_user_id');",
									"    const d = drivers.find((x) => x.user && x.user.id === uid);",
									"    pm.expect(d, 'driver profile for driver@test.com').to.exist;",
									"    pm.environment.set('test_driver_id', d.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{deployment_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/drivers",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"drivers"
							]
						}
					}
				}
			]
		},
		{
			"name": "3. Trip Request Workflow",
			"item": [
				{
					"name": "Step 1: Employee Creates Trip Request",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const start = new Date(Date.now() + 72 * 60 * 60 * 1000);",
									"const end = new Date(start.getTime() + 8 * 60 * 60 * 1000);",
									"pm.environment.set('trip_start_iso', start.toISOString());",
									"pm.environment.set('trip_end_iso', end.toISOString());"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Trip created (48h+ advance rule)', function () {",
									"    pm.expect([200, 201]).to.include(pm.response.code);",
									"});",
									"const response = pm.response.json();",
									"pm.environment.set('trip_id', response.id);",
									"if (response.requestNumber) {",
									"    pm.environment.set('trip_request_number', response.requestNumber);",
									"}",
									"console.log('Trip created with ID:', response.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{employee_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tripType\": \"Normal\",\n  \"destination\": \"Addis Ababa\",\n  \"purpose\": \"Business meeting with partners\",\n  \"startDateTime\": \"{{trip_start_iso}}\",\n  \"endDateTime\": \"{{trip_end_iso}}\",\n  \"passengerCount\": 5\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/trips",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"trips"
							]
						}
					}
				},
				{
					"name": "Step 2: Employee Submits Trip for Approval",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    console.log('Trip submitted. New state:', response.state);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{employee_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/trips/{{trip_id}}/submit",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"trips",
								"{{trip_id}}",
								"submit"
							]
						}
					}
				},
				{
					"name": "Step 3: Department Head Approves",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    const response = pm.response.json();",
