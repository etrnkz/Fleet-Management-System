								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('employee_token', response.access_token);",
									"    pm.environment.set('employee_user_id', response.user.id);",
