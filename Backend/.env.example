# ─────────────────────────────────────────────────────────────────────────────
# Haramaya University Fleet Management System — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to version control.

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=fleet_management
DB_LOGGING=false
# DB_SYNCHRONIZE=true   # only set true once on a fresh DB, then remove

# ── JWT ───────────────────────────────────────────────────────────────────────
# Normal session  : 7 hours access  / 7 days refresh
# Remember Me     : 45 days access  / 45 days refresh  (set in auth.service.ts)
JWT_SECRET=replace_with_a_random_min_32_character_string
JWT_EXPIRATION=7h
JWT_REFRESH_SECRET=replace_with_another_random_min_32_character_string
JWT_REFRESH_EXPIRATION=7d

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM="Fleet Management <your-email@gmail.com>"

# ── SMS (Brevo) ───────────────────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key-here
SMS_SENDER_NAME=FleetMgmt

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── Frontend URL (for password reset links) ───────────────────────────────────
FRONTEND_URL=http://localhost:3001

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=warn
