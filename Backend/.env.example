# ─────────────────────────────────────────────────────────────────────────────
# Haramaya University Fleet Management System — Environment Template
# Copy to .env and fill in your values.
#
# Quick start (development):
#   cp .env.example .env
#   npm install
#   npm run migration:run   (or set DB_SYNCHRONIZE=true once)
#   npm run seed
#   npm run start:dev
#
# Production: use .env.production.example instead.
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Create the database first:
#   psql -U postgres -c "CREATE DATABASE fleet_management;"
# Or use pgAdmin: Databases → Create → fleet_management
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=fleet_management
DB_LOGGING=false
# First run on empty DB: set true once, then remove or set false
# DB_SYNCHRONIZE=true

# ── JWT ───────────────────────────────────────────────────────────────────────
# Normal session  : 7h access  / 7d refresh
# Remember Me (45d): handled automatically in auth.service.ts when keepMeSignedIn=true
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-min-32-char-random-secret
JWT_EXPIRATION=7h
JWT_REFRESH_SECRET=replace-with-another-min-32-char-random-secret
JWT_REFRESH_EXPIRATION=7d

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password (not your account password):
#   Google Account → Security → 2-Step Verification → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM="Fleet Management <your-email@gmail.com>"

# ── SMS (Brevo) ───────────────────────────────────────────────────────────────
# Get API key from: https://app.brevo.com → API Keys
BREVO_API_KEY=
SMS_SENDER_NAME=FleetMgmt

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── Frontend URL (for password reset email links) ─────────────────────────────
FRONTEND_URL=http://localhost:3001

# ── Logging ───────────────────────────────────────────────────────────────────
# development: debug | production: warn or error
LOG_LEVEL=debug
