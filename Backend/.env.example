# Local development template. For a VPS / PM2 deploy, start from:
#   .env.production.example  →  copy to .env on the server
# Migrations:  npm run migrate   or   ./scripts/migrate.sh
# Wipe Postgres DB and recreate empty:  ./scripts/recreate-database.sh  (Linux/macOS)
#   or:  npm run db:recreate:postgres:win   (Windows PowerShell)

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Seed all test accounts (API must be running): npm run seed:all  OR  python seed_all.py
# Remote: FLEET_API_BASE=https://api.example.com/api/v1 python seed_all.py
# Clear trips (SQLite file DB only): npm run db:clear-trips
# Clear all but users: npm run db:reset-except-users (SQLite runs automatically; Postgres: use scripts/*.postgres.sql with psql)

# CORS is open to all origins (reflects request Origin; see Backend/src/config/cors-origins.ts).

# Database — PostgreSQL by default (DB_HOST / DB_* or DATABASE_URL).
# Create DB once:
#   cd Backend
#   $env:PGPASSWORD='YOUR_PASSWORD'; psql -U postgres -h localhost -d postgres -f scripts/create-database.sql
#   or:  npm run db:create:interactive   (prompts for Postgres password in this terminal)
#   or:  set PGPASSWORD then npm run db:create
#   or pgAdmin: Databases → Create → Database → name: fleet_management
# Local dev: schema auto-syncs for Postgres when NODE_ENV is not production (omit DB_SYNCHRONIZE).
# Force: DB_SYNCHRONIZE=true | false
# Optional file DB: DB_TYPE=sqlite  or  USE_SQLITE=true  (fleet_management.db)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fleet_management
# On some Linux VPS, localhost resolves to ::1; if password auth fails, try 127.0.0.1
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# Testing default — must match the real Postgres role password. If auth fails on Linux:
#   bash scripts/set-postgres-dev-password.sh
DB_PASSWORD=postgres
DB_NAME=fleet_management
# First deploy with empty DB (no migrations yet): set DB_SYNCHRONIZE=true, restart API once, verify tables, then false.
# DB_SYNCHRONIZE=false
# Production: set NODE_ENV=production (sync off by default) and use migrations: npm run build && npm run migration:run
DB_LOGGING=true
# Optional: run pending migrations on API startup (alternative to npm run migration:run)
# DB_RUN_MIGRATIONS=true
# Managed Postgres TLS:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# Quote if the value contains spaces or < > (avoid broken shell exports)
EMAIL_FROM="Fleet Management <noreply@fleet.school.edu>"

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@school.edu

# External Services (optional)
GPS_PROVIDER_URL=http://gps-service:8080
SCANNER_API_URL=http://scanner-service:8080

# Logging
LOG_LEVEL=debug
